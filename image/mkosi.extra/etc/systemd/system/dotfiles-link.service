[Unit]
Description=Link dotfiles from the read-only mount into the agent's home
# The mount is virtiofs and nofail, so it may be absent; the script handles
# that rather than the unit failing. Runs after it so the files are there.
After=etc-dotfiles.mount local-fs.target
Wants=etc-dotfiles.mount
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/dotfiles-link

[Install]
WantedBy=multi-user.target
